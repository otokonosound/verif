{
  "manifest_version": 3,
  "name": "VÉRIF — Vérifie avant d'agir",
  "version": "1.0.0",
  "description": "Vérifie rapidement une page, un lien ou du texte avant d'agir.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "VÉRIF — Vérifier cette page",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}