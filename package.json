{
  "name": "verif",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:extension": "node --test extension/test/*.test.mjs",
    "api": "node server/index.mjs",
    "test:api": "node --test server/*.test.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "prebuild": "npm run build:engine",
    "pretest": "npm run build:engine",
    "pretest:api": "npm run build:engine",
    "preapi": "npm run build:engine",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test && npm run test:extension && npm run test:api && npm run build && node scripts/check-runtime.mjs",
    "test:e2e": "playwright test",
    "postbuild": "node scripts/release.mjs",
    "pretest:extension": "npm run build:engine"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "jsqr": "1.4.0",
    "jszip": "3.10.1",
    "lucide-react": "1.53.0",
    "mammoth": "1.11.0",
    "pako": "2.1.0",
    "pdfjs-dist": "5.4.149",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "tldts": "7.4.18",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/pako": "2.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "vitest": "5.0.3"
  }
}
